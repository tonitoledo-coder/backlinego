{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la empresa"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "city": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categor\u00edas de equipos que ofrecen"
    },
    "sos_service": {
      "type": "boolean",
      "default": false,
      "description": "Ofrece servicio SOS 24h"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}