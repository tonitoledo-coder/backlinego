{
  "name": "LegalDocument",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "terms",
        "privacy"
      ],
      "description": "Tipo de documento legal"
    },
    "version": {
      "type": "string",
      "description": "Versi\u00f3n del documento (ej. 1.0, 1.1, 2.0)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo visible del documento"
    },
    "content": {
      "type": "string",
      "description": "Cuerpo completo del documento en formato Markdown"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de entrada en vigor"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Solo un documento de cada type puede estar activo a la vez"
    },
    "published_by": {
      "type": "string",
      "description": "Email del admin que lo public\u00f3"
    }
  },
  "required": [
    "type",
    "version",
    "title",
    "content",
    "effective_date"
  ]
}